# Optional. Leave blank for the fully functional synthetic Demo workspace.
# Create a free Supabase project, apply supabase/migrations, then copy its public URL/key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon public key is supported instead of PUBLISHABLE_KEY:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Never put service-role, secret, bookmaker or paid API keys in NEXT_PUBLIC variables.

# Optional FUTURE one-shot The Odds API readiness. Not required by Research Handoff.
# Correct service: https://the-odds-api.com/ (not theoddsapi.com).
# Server-only; never prefix these settings with NEXT_PUBLIC. Leave disabled for A$0 handoff mode.
THE_ODDS_API_KEY=
THE_ODDS_API_ENABLE_MANUAL_REQUESTS=false
THE_ODDS_API_FREE_PLAN_CONFIRMED=false
# Keep a free-credit reserve; the adapter has no automatic polling or retries.
THE_ODDS_API_CREDIT_RESERVE=10
THE_ODDS_API_MAX_AGE_SECONDS=300

# Optional read-only sports data; no automatic requests, polling or paid upgrade.
# Supported only on a local, single-process Node server. Disabled by default.
EDGELAB_SPORTS_DATA_MODE=disabled
# Set mode to local-single-process only after reviewing docs/sports-data.md.
# Private API-Sports key: enter locally, never in chat or NEXT_PUBLIC variables.
API_SPORTS_KEY=
# May lower these budgets; code caps them at 70/day and 6/min per API.
API_NBA_DAILY_BUDGET=70
API_NBA_MINUTE_BUDGET=6
API_BASKETBALL_DAILY_BUDGET=70
API_BASKETBALL_MINUTE_BUDGET=6

# Optional V6 team-game research only. Permanent Free tier; no trial/payment setup.
# Server-only; the collector never calls paid player statistics or injury endpoints.
BALLDONTLIE_API_KEY=

# Optional V6 read-only hosted dashboard. Vercel always uses cloud evidence.
# Public Supabase variables above belong in both Vercel Production and Preview.
# This binding is server-only; copy the existing owned archive anchor from local config.
V6_EVIDENCE_MODE=local
V6_HISTORY_BATCH_ID=
# VERCEL_URL / VERCEL_BRANCH_URL are supplied by Vercel, never by the browser.

# FUTURE GitHub Actions source-only runner; leave disabled until separate approvals.
# Provider keys belong only in its protected Environment secrets, never on Vercel.
V6_CLOUD_SOURCE_ENABLED=false
V6_CLOUD_REVIEWED_SHA=
V6_CLOUD_PILOT_ID=
# Opaque SOURCE-ONLY capability, issued by the owner only after explicit approval.
V6_SOURCE_CAPABILITY=
